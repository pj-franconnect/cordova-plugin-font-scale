<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android"
    id="cordova-plugin-font-scale"
    version="1.0.0">
    <name>Font Scale</name>
    <description>Reads the device text-size setting (Android font scale, iOS Dynamic Type) and controls the Android WebView text zoom.</description>
    <author>Prasun Jajodia</author>
    <license>Apache 2.0</license>
    <keywords>cordova,plugin,accessibility,font,text size,dynamic type</keywords>

    <js-module src="www/font-scale.js" name="fontScale">
        <clobbers target="cordova.plugins.fontScale" />
    </js-module>

    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="FontScale">
                <param name="android-package" value="com.rizepoint.cordova.fontscale.FontScale" />
            </feature>
        </config-file>
        <source-file src="src/android/FontScale.java" target-dir="src/com/rizepoint/cordova/fontscale" />
    </platform>

    <platform name="ios">
        <config-file target="config.xml" parent="/*">
            <feature name="FontScale">
                <param name="ios-package" value="CDVFontScale" />
            </feature>
        </config-file>
        <header-file src="src/ios/CDVFontScale.h" />
        <source-file src="src/ios/CDVFontScale.m" />
    </platform>
</plugin>
